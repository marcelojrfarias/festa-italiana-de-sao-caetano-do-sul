{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://festa-italiana/schemas/festa.schema.json",
  "title": "Dados de uma edicao da festa",
  "type": "object",
  "required": ["id", "ano", "nome", "local", "funcionamento"],
  "additionalProperties": false,
  "$defs": {
    "data": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "hora": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
    "coordenadas": {
      "type": ["object", "null"],
      "required": ["latitude", "longitude"],
      "additionalProperties": false,
      "properties": {
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 }
      }
    }
  },
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "ano": { "type": "integer", "minimum": 2000, "maximum": 2100 },
    "nome": { "type": "string", "minLength": 1 },
    "subtitulo": { "type": "string" },
    "descricao": { "type": "string" },

    "local": {
      "type": "object",
      "required": ["nome", "endereco"],
      "additionalProperties": false,
      "properties": {
        "nome": { "type": "string", "minLength": 1 },
        "endereco": {
          "type": "object",
          "required": ["logradouro", "cidade", "estado"],
          "additionalProperties": false,
          "properties": {
            "logradouro": { "type": "string", "minLength": 1 },
            "numero": { "type": "string" },
            "complemento": { "type": "string" },
            "bairro": { "type": "string" },
            "cidade": { "type": "string", "minLength": 1 },
            "estado": { "type": "string", "pattern": "^[A-Z]{2}$" },
            "cep": { "type": "string", "pattern": "^(\\d{5}-?\\d{3})?$" }
          }
        },
        "coordenadas": { "$ref": "#/$defs/coordenadas" },
        "comoChegar": { "type": "string" }
      }
    },

    "funcionamento": {
      "type": "object",
      "required": ["fusoHorario", "inicio", "fim", "dias"],
      "additionalProperties": false,
      "properties": {
        "fusoHorario": { "type": "string", "minLength": 1 },
        "inicio": { "$ref": "#/$defs/data" },
        "fim": { "$ref": "#/$defs/data" },
        "observacao": { "type": "string" },
        "dias": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["data", "abertura", "fechamento"],
            "additionalProperties": false,
            "properties": {
              "data": { "$ref": "#/$defs/data" },
              "abertura": { "$ref": "#/$defs/hora" },
              "fechamento": { "$ref": "#/$defs/hora" },
              "observacao": { "type": "string" }
            }
          }
        }
      }
    },

    "informacoes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "titulo", "conteudo", "ordem"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "titulo": { "type": "string", "minLength": 1 },
          "icone": { "type": "string" },
          "ordem": { "type": "integer", "minimum": 0 },
          "conteudo": { "type": "string", "minLength": 1 }
        }
      }
    },

    "contato": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "site": { "type": "string" },
        "instagram": { "type": "string" },
        "facebook": { "type": "string" },
        "whatsapp": { "type": "string" },
        "telefone": { "type": "string" },
        "email": { "type": "string" }
      }
    }
  }
}
